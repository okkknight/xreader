{
  "name": "xreader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-file:../data/xreader.db} next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "VITEST_INTEGRATION=1 DATABASE_URL=${DATABASE_URL:-file:../data/test.db} vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-file:../data/xreader.db} tsx scripts/migrate.ts",
    "course:import": "DATABASE_URL=${DATABASE_URL:-file:../data/xreader.db} tsx scripts/import-course.ts --",
    "course:build": "tsx scripts/build-course.ts --",
    "course:audio": "tsx scripts/generate-course-audio.ts --",
    "course:convert-audio": "tsx scripts/convert-course-audio.ts --",
    "course:reading-audio": "tsx scripts/generate-reading-audio.ts --",
    "course:check": "tsx scripts/check-course.ts --",
    "audio:audition": "tsx scripts/audition-voices.ts --"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.4.0",
    "prisma": "6.19.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
