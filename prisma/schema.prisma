generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  IDEA
  SOURCED
  ARTICLE_DRAFT
  ARTICLE_EDITED
  ANALYZED
  DIRECTED
  SCRIPTED
  AUDIO_READY
  QA_PASSED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum GuideDepth {
  QUICK
  NORMAL
  DEEP
}

enum AudioStatus {
  MISSING
  QUEUED
  GENERATING
  READY
  STALE
  FAILED
}

enum CourseScriptGenerationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
  APPROVED
}

model Article {
  id              String        @id
  slug            String        @unique
  titleEn         String
  titleZh         String
  dekZh           String?
  topic           String
  difficulty      String        @default("B1-B2")
  status          ArticleStatus @default(IDEA)
  bodyText        String
  wordCount       Int           @default(0)
  estimatedReadMs Int?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  paragraphs      Paragraph[]
  sources         ArticleSource[]
  paragraphGuides ParagraphGuide[]
  feedback        ArticleFeedback[]
  scriptGenerations CourseScriptGeneration[]
  qa              ArticleQa?
}

model Paragraph {
  id        String     @id
  articleId String
  order     Int
  text      String

  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sentences Sentence[]
  guides    ParagraphGuide[] @relation("ParagraphToGuides")
  sentenceGuides SentenceGuide[] @relation("ParagraphToSentenceGuides")

  @@unique([articleId, order])
}

model Sentence {
  id            String       @id
  paragraphId   String
  order         Int
  text          String
  translationZh String?
  startOffset   Int?
  endOffset     Int?

  paragraph     Paragraph    @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  annotations   Annotation[]
  guides        SentenceGuide[]

  @@unique([paragraphId, order])
}

model Source {
  id          String          @id @default(cuid())
  title       String
  publisher   String?
  url         String
  publishedAt DateTime?
  accessedAt  DateTime?
  notes       String?

  articles    ArticleSource[]
}

model ArticleSource {
  articleId String
  sourceId  String
  role      String
  factNotes Json?

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model ParagraphGuide {
  id                 String      @id
  articleId          String
  paragraphId        String
  order              Int
  paragraphGoal      String
  openingBridge      String?
  paragraphWrap      String?
  nextParagraphBridge String?
  scriptText         String
  audioPath          String?
  audioDurationMs    Int?
  audioStatus        AudioStatus @default(MISSING)
  textHash           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  article            Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  paragraph          Paragraph   @relation("ParagraphToGuides", fields: [paragraphId], references: [id], onDelete: Cascade)
  sentenceGuides     SentenceGuide[]

  @@unique([articleId, order])
  @@unique([articleId, paragraphId])
}

model SentenceGuide {
  id                    String      @id
  paragraphGuideId      String
  paragraphId           String
  sentenceId            String
  order                 Int
  depth                 GuideDepth
  originalReadText      String
  meaningZh             String
  sentenceFunction      String
  primaryTeachingGoal   String
  focusScript           String?
  bridgeScript          String?
  likelyMisunderstanding String?
  expressionTarget      String?
  replayAfterExplanation Boolean    @default(false)
  estimatedStartMs      Int?
  estimatedEndMs        Int?

  paragraphGuide        ParagraphGuide @relation(fields: [paragraphGuideId], references: [id], onDelete: Cascade)
  paragraph             Paragraph      @relation("ParagraphToSentenceGuides", fields: [paragraphId], references: [id], onDelete: Cascade)
  sentence              Sentence      @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([paragraphGuideId, sentenceId])
  @@unique([paragraphGuideId, order])
}

model Annotation {
  id          String   @id @default(cuid())
  sentenceId  String
  startOffset Int
  endOffset   Int
  text        String
  meaningZh   String
  noteZh      String?
  exampleEn   String?
  audioPath   String?

  sentence    Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
}

model AudioAsset {
  id                String      @id @default(cuid())
  ownerType         String
  ownerId           String
  provider          String
  voiceId           String
  path              String
  format            String
  durationMs        Int
  textHash          String
  providerRequestId String?
  status            AudioStatus
  error             String?
  createdAt         DateTime    @default(now())

  @@index([ownerType, ownerId])
}

model CourseScriptGeneration {
  id                    String                       @id @default(cuid())
  articleId             String
  version               Int
  status                CourseScriptGenerationStatus @default(RUNNING)
  currentStage          String?
  promptVersion         String
  model                 String?
  inputHash             String
  promptVersions        Json
  temperature           Float?
  articleUnderstanding  Json?
  narrativePlan         Json?
  sentenceAnalysis      Json?
  languageLearningMap   Json?
  lessonDesignRationale Json?
  teachingBeatPlan      Json?
  teacherPerformancePlan Json?
  fullScriptDraft       Json?
  editedScript          Json?
  englishTeachingEdit   Json?
  humanVoiceEdit        Json?
  qualityReview         Json?
  finalQualityReview    Json?
  instructionalQualityReview Json?
  qualityEvidence       Json?
  calibrationNotes      Json?
  repairHistory         Json?
  finalScript           Json?
  manuallyEdited        Boolean                      @default(false)
  parentVersionId       String?
  error                 String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  completedAt           DateTime?

  article               Article                      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
}

model ArticleFeedback {
  id           String   @id @default(cuid())
  articleId    String
  sessionId    String
  difficulty   String?
  density      String?
  worthReading Boolean?
  createdAt    DateTime @default(now())

  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model ArticleQa {
  id          String   @id @default(cuid())
  articleId   String   @unique
  automated   Json
  humanChecks Json
  passedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}
