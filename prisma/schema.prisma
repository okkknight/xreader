generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  IDEA
  SOURCED
  ARTICLE_DRAFT
  ARTICLE_EDITED
  BUILT
  QA_PASSED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CourseDocumentStatus {
  BUILT
  NEEDS_REVIEW
  IMPORTED
}

enum CourseAudioStatus {
  READY
  MISSING
  FAILED
}

model Article {
  id              String        @id
  slug            String        @unique
  titleEn         String
  titleZh         String
  dekZh           String?
  topic           String
  difficulty      String        @default("B1-B2")
  status          ArticleStatus @default(IDEA)
  bodyText        String
  wordCount       Int           @default(0)
  estimatedReadMs Int?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  paragraphs      Paragraph[]
  sources         ArticleSource[]
  annotations     Annotation[]
  courseDocument  CourseDocument?
  feedback        ArticleFeedback[]
}

model Paragraph {
  id        String     @id
  articleId String
  order     Int
  text      String

  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sentences Sentence[]

  @@unique([articleId, order])
}

model Sentence {
  id            String       @id
  paragraphId   String
  order         Int
  text          String
  translationZh String?
  startOffset   Int?
  endOffset     Int?

  paragraph     Paragraph    @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  annotations   Annotation[]

  @@unique([paragraphId, order])
}

model Source {
  id          String          @id @default(cuid())
  title       String
  publisher   String?
  url         String
  publishedAt DateTime?
  accessedAt  DateTime?
  notes       String?

  articles    ArticleSource[]
}

model ArticleSource {
  articleId String
  sourceId  String
  role      String
  factNotes Json?

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model Annotation {
  id          String   @id @default(cuid())
  articleId   String
  sentenceId  String
  startOffset Int
  endOffset   Int
  text        String
  meaningZh   String
  noteZh      String?
  exampleEn   String?

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sentence    Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
}

model CourseDocument {
  id                String               @id @default(cuid())
  articleId         String               @unique
  schemaVersion     Int                  @default(1)
  sourceMarkdown    String
  finalLectureMarkdown String
  sourceHash        String
  finalLectureHash  String
  courseJson        Json
  parseReport       Json?
  status            CourseDocumentStatus @default(BUILT)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  article           Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  audio             CourseBlockAudio[]
}

model CourseBlockAudio {
  id               String            @id @default(cuid())
  courseDocumentId String
  audioId          String            @unique
  blockIds         Json
  path             String
  durationMs       Int
  status           CourseAudioStatus @default(MISSING)
  scriptHash       String
  provider         String?
  referenceId      String?
  createdAt        DateTime          @default(now())

  courseDocument   CourseDocument    @relation(fields: [courseDocumentId], references: [id], onDelete: Cascade)

  @@index([courseDocumentId])
}

model ArticleFeedback {
  id           String   @id @default(cuid())
  articleId    String
  sessionId    String
  difficulty   String?
  density      String?
  worthReading Boolean?
  createdAt    DateTime @default(now())

  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}
